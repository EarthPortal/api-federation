# API keys for the OntoPortal sources. Copy this file to .env and fill in every value:
# the gateway refuses to start if a key used in the databases config is missing or empty.
# Each key comes from an account on that portal (ontoportal-astro needs its own, it no longer reuses the AgroPortal one).

AGROPORTAL_API_KEY=
EARTHPORTAL_API_KEY=
BIODIVPORTAL_API_KEY=
ECOPORTAL_API_KEY=
LOVPORTAL_API_KEY=
ONTOPORTAL_ASTRO_API_KEY=
